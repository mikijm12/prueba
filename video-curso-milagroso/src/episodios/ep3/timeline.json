 "lines": [
  {
   "who": "junior",
   "text": "Ya, Ingenito, ya guardé el plano.",
   "from": 9,
   "to": 65
  },
  {
   "who": "ingenito",
   "text": "Colega, tienes más finales que novela turca.",
   "from": 125,
   "to": 210
  },
  {
   "who": "teo",
   "text": "Tranquilo, inge. Con el tarrajeo no se nota.",
   "from": 246,
   "to": 331
  },
  {
   "who": "junior",
   "text": "Ah, ya. Entonces normal, ¿no?",
   "from": 331,
   "to": 391
  },
  {
   "who": "ingenito",
   "text": "¡¿Normal?! ¡Eso no se tapa, se repara, maestro!",
   "from": 430,
   "to": 544
  },
  {
   "who": "teo",
   "text": "Toda la vida lo hemos hecho así, joven.",
   "from": 544,
   "to": 615
  },
  {
   "who": "ingenito",
   "text": "Toda la vida también se han caído cosas, maestro.",
   "from": 615,
   "to": 706
  },
  {
   "who": "supervisora",
   "text": "Buenos días. ¿Y el cuaderno de obra?",
   "from": 754,
   "to": 809
  },
  {
   "who": "teo",
   "text": "¿El cuaderno? Se lo comió el perro, ingeniera.",
   "from": 809,
   "to": 920
  },
  {
   "who": "caption",
   "text": "( sálvame, Ingenito )",
   "from": 920,
   "to": 944
  },
  {
   "who": "ingenito",
   "text": "Tranquila, inge. Aquí está todo: dibujado, acotado y con su artículo.",
   "from": 944,
   "to": 1098
  },
  {
   "who": "supervisora",
   "text": "Ya… ¿y esto de dónde lo sacaron?",
   "from": 1098,
   "to": 1151
  },
  {
   "who": "ingenito",
   "text": "Del RNE Ilustrado, inge. Para que no lo agarren en curva.",
   "from": 1151,
   "to": 1277
  },
  {
   "who": "ingenito",
   "text": "Las 73 normas del RNE, dibujadas.",
   "from": 1283,
